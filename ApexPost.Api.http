@courierToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJDT1VSSUVSLT0wMDEiLCJpc3MiOiJodHRwczovL2FwZXhwb3N0LmF1dGgubG9jYWwiLCJhdWQiOiJhcGV4cG9zdC1hcGkiLCJleHAiOjk5OTk5OTk5OTksImlhdCI6MTcwMDAwMDAwMCwiY291cmllcklkIjoiQ09VUklFUi0wMDEiLCJyb2xlIjoiQ291cmllciJ9.fake_token
@invalidToken = invalid.token.here
